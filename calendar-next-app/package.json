    "dompurify": "3.4.16",
    "fuse.js": "7.5.0",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.11.2",
    "marked": "18.0.14",
    "motion": "13.4.4",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
